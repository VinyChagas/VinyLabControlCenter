# Copie para .env na VPS e preencha com valores reais.
# NÃO versione .env.

NODE_ENV=production
APP_ENV=vps
PORT=3001

# Origem pública do frontend (CORS + CSRF Origin).
FRONTEND_URL=https://control.vinichagas.cloud

# Host Docker interno do PostgreSQL já existente na VPS
DATABASE_URL=postgresql://USER:PASSWORD@vinylab-postgres:5432/vinylab_control_center

# Chave mestra AES-256-GCM (mínimo 32 caracteres). Gere uma única vez e preserve.
SECRET_MASTER_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Sessão do Control Center (cookie HttpOnly)
SESSION_TTL_HOURS=72

# O primeiro OWNER é criado via fluxo interativo /setup (não use variáveis de bootstrap).
