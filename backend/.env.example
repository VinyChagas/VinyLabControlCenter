NODE_ENV=development
APP_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
SECRET_MASTER_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
SESSION_TTL_HOURS=72

# Prometheus (DEV: http://127.0.0.1:9090 se a porta estiver publicada; VPS: http://prometheus:9090)
PROMETHEUS_URL=http://127.0.0.1:9090
PROMETHEUS_TIMEOUT_MS=5000
METRICS_COLLECTION_INTERVAL_SECONDS=60

# Opcionais para Informações do Sistema
SYSTEM_HOSTNAME=
SYSTEM_PRIMARY_IP=

# O primeiro OWNER é criado via fluxo interativo /setup (não use variáveis de bootstrap).
