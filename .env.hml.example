# Copie para .env.hml na VPS e preencha com valores reais.
# NÃO versione .env.hml.

NODE_ENV=production
APP_ENV=homologation
PORT=3001

# URL pública do frontend (CORS). Ajuste quando o Caddy/DNS estiverem prontos.
FRONTEND_URL=https://control.example.com

# Host Docker interno do PostgreSQL já existente na VPS
DATABASE_URL=postgresql://USER:PASSWORD@vinylab-postgres:5432/DATABASE

# Chave mestra AES-256-GCM (mínimo 32 caracteres). Gere uma única vez e preserve.
SECRET_MASTER_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
